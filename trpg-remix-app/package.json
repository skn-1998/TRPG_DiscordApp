{
  "name": "trpg-remix-app",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0 --port 5173",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit": "pnpm audit --audit-level moderate",
    "audit:signatures": "pnpm audit signatures",
    "deps:check": "pnpm install --frozen-lockfile",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html}\" --log-level warn"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/form": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@mantine/modals": "7.17.8",
    "@mantine/notifications": "7.17.8",
    "@mantine/nprogress": "7.17.8",
    "@tabler/icons-react": "3.44.0",
    "axios": "^1.17.0",
    "cookie": "^1.0.1",
    "fuse.js": "^7.1.0",
    "immer": "^10.1.1",
    "lodash": "^4.18.1",
    "moji": "^0.5.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/moji": "^0.5.3",
    "@types/node": "^22.12.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-next": "16.2.10",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.14.4",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.44.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
