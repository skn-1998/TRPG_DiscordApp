{
  "name": "trpg-remix-app",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "WATCHPACK_POLLING=true remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit": "pnpm audit --audit-level moderate",
    "audit:signatures": "pnpm audit signatures",
    "deps:check": "pnpm install --frozen-lockfile",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,html}\" --log-level warn"
  },
  "dependencies": {
    "@mantine/core": "^7.8.0",
    "@mantine/form": "^7.8.0",
    "@mantine/hooks": "^7.8.0",
    "@mantine/modals": "^7.8.0",
    "@mantine/notifications": "^7.8.0",
    "@mantine/nprogress": "^7.8.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.16.8",
    "@tabler/icons-react": "^3.2.0",
    "@trpg/sheet-engine": "workspace:*",
    "axios": "^1.17.0",
    "cookie": "^1.0.1",
    "fuse.js": "^7.1.0",
    "immer": "^10.1.1",
    "isbot": "^4.4.0",
    "lodash": "^4.18.1",
    "moji": "^0.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@remix-run/dev": "2.16.8",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.0",
    "@types/moji": "^0.5.3",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "esbuild": "0.28.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.14.4",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.6.2",
    "remix-flat-routes": "^0.8.5",
    "ts-jest": "^29.1.2",
    "typescript": "5.4.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^5.4.20",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
