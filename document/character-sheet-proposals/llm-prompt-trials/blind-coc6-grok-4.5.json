    {
      "id": "status",
      "label": "ステータス",
      "fields": [
        {
          "type": "track",
          "id": "hp",
          "uid": "status_hp",
          "label": "HP",
          "style": "gauge",
          "max": {
            "formula": "floor(({abilities.con} + {abilities.siz}) / 2)"
          },
          "role": {
            "kind": "resource",
            "deltas": [-1, 1]
          }
        },
        {
          "type": "track",
          "id": "mp",
          "uid": "status_mp",
          "label": "MP",
          "style": "gauge",
          "max": {
            "formula": "{abilities.pow}"
          },
          "role": {
            "kind": "resource",
            "deltas": [-1, 1]
          }
        },
        {
          "type": "track",
          "id": "san",
          "uid": "status_san",
          "label": "SAN",
          "style": "gauge",
          "max": {
            "formula": "{abilities.pow} * 5"
          },
          "role": {
            "kind": "resource",
            "deltas": [-1, 1]
          }
        },
        {
          "type": "computed",
          "id": "san_max",
          "uid": "status_san_max",
          "label": "最大SAN",
          "resultType": "number",
          "formula": "{abilities.pow} * 5"
        },
        {
          "type": "computed",
          "id": "idea",
          "uid": "status_idea",
          "label": "アイデア",
          "resultType": "number",
          "formula": "{abilities.int} * 5"
        },
        {
          "type": "computed",
          "id": "luck",
          "uid": "status_luck",
          "label": "幸運",
          "resultType": "number",
          "formula": "{abilities.pow} * 5"
        },
        {
          "type": "computed",
          "id": "know",
          "uid": "status_know",
          "label": "知識",
          "resultType": "number",
          "formula": "{abilities.edu} * 5"
        },
        {
          "type": "computed",
          "id": "db",
          "uid": "status_db",
          "label": "ダメージボーナス",
          "resultType": "dice",
          "formula": "lookup({abilities.str} + {abilities.siz}, damage_bonus)"
        },
        {
          "type": "computed",
          "id": "job_points",
          "uid": "status_job_points",
          "label": "職業技能ポイント",
          "resultType": "number",
          "formula": "{abilities.edu} * 20"
        },
        {
          "type": "computed",
          "id": "interest_points",
          "uid": "status_interest_points",
          "label": "興味技能ポイント",
          "resultType": "number",
          "formula": "{abilities.int} * 10"
        },
        {
          "type": "scalar",
          "id": "mov",
          "uid": "status_mov",
          "label": "MOV",
          "valueType": "number"
        }
      ]
    },
