{
  "name": "クトゥルフ神話TRPG（第6版）",
  "version": "1.0.0",
  "schemaVersion": 3,
  "gameSystemId": "Cthulhu",
  "settings": {
    "rounding": "floor"
  },
  "sections": [
    {
      "id": "profile",
      "label": "プロフィール",
      "fields": [
        {
          "type": "scalar",
          "id": "job",
          "uid": "profile_job",
          "label": "職業",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "age",
          "uid": "profile_age",
          "label": "年齢",
          "valueType": "number"
        },
        {
          "type": "scalar",
          "id": "gender",
          "uid": "profile_gender",
          "label": "性別",
          "valueType": "text"
        }
      ]
    },
    {
      "id": "abilities",
      "label": "能力値",
      "fields": [
        {
          "type": "scalar",
          "id": "str",
          "uid": "abilities_str",
          "label": "STR",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "con",
          "uid": "abilities_con",
          "label": "CON",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "pow",
          "uid": "abilities_pow",
          "label": "POW",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "dex",
          "uid": "abilities_dex",
          "label": "DEX",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "app",
          "uid": "abilities_app",
          "label": "APP",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "siz",
          "uid": "abilities_siz",
          "label": "SIZ",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "2d6+6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "int",
          "uid": "abilities_int",
          "label": "INT",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "2d6+6"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "edu",
          "uid": "abilities_edu",
          "label": "EDU",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6+3"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}*5",
            "group": "ability"
          }
        }
      ]
    },
    {
      "id": "status",
      "label": "ステータス",
      "fields": [
        {
          "type": "track",
          "id": "hp",
          "uid": "status_hp",
          "label": "HP",
          "style": "gauge",
          "max": {
            "formula": "ceil(({abilities.con} + {abilities.siz}) / 2)"
          },
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              1
            ]
          }
        },
        {
          "type": "track",
          "id": "mp",
          "uid": "status_mp",
          "label": "MP",
          "style": "gauge",
          "max": {
            "formula": "{abilities.pow}"
          },
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              1
            ]
          }
        },
        {
          "type": "track",
          "id": "san",
          "uid": "status_san",
          "label": "SAN",
          "style": "gauge",
          "max": 99,
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              1
            ]
          }
        },
        {
          "type": "computed",
          "id": "idea",
          "uid": "status_idea",
          "label": "アイデア",
          "resultType": "number",
          "formula": "{abilities.int} * 5"
        },
        {
          "type": "computed",
          "id": "luck",
          "uid": "status_luck",
          "label": "幸運",
          "resultType": "number",
          "formula": "{abilities.pow} * 5"
        },
        {
          "type": "computed",
          "id": "know",
          "uid": "status_know",
          "label": "知識",
          "resultType": "number",
          "formula": "{abilities.edu} * 5"
        },
        {
          "type": "computed",
          "id": "db",
          "uid": "status_db",
          "label": "ダメージボーナス",
          "resultType": "dice",
          "formula": "lookup({abilities.str} + {abilities.siz}, damage_bonus)"
        }
      ]
    },
    {
      "id": "skills",
      "label": "技能",
      "fields": [
        {
          "type": "list",
          "id": "list",
          "uid": "skills_list",
          "label": "技能一覧",
          "itemFields": [
            {
              "type": "scalar",
              "id": "name",
              "uid": "skills_list_name",
              "label": "技能名",
              "valueType": "text"
            },
            {
              "type": "scalar",
              "id": "value",
              "uid": "skills_list_value",
              "label": "技能値",
              "valueType": "number"
            }
          ],
          "rowRole": {
            "kind": "rollable",
            "notation": "1d100<={row.value}"
          }
        }
      ]
    },
    {
      "id": "memo",
      "label": "メモ",
      "fields": [
        {
          "type": "scalar",
          "id": "background",
          "uid": "memo_background",
          "label": "経歴",
          "valueType": "text"
        }
      ]
    }
  ],
  "tables": [
    {
      "id": "damage_bonus",
      "resultType": "dice",
      "rows": [
        {
          "min": -999999,
          "max": 12,
          "result": "-1d6"
        },
        {
          "min": 13,
          "max": 16,
          "result": "-1d4"
        },
        {
          "min": 17,
          "max": 24,
          "result": "0"
        },
        {
          "min": 25,
          "max": 32,
          "result": "+1d4"
        },
        {
          "min": 33,
          "max": 40,
          "result": "+1d6"
        },
        {
          "min": 41,
          "max": 999999,
          "result": "+2d6"
        }
      ]
    }
  ]
}