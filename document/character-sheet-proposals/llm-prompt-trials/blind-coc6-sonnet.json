    },
    {
      "id": "abilities",
      "label": "能力値",
      "fields": [
        {
          "type": "scalar",
          "id": "str",
          "uid": "abilities_str",
          "label": "筋力 (STR)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "con",
          "uid": "abilities_con",
          "label": "体力 (CON)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "pow",
          "uid": "abilities_pow",
          "label": "精神力 (POW)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "dex",
          "uid": "abilities_dex",
          "label": "敏捷性 (DEX)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "app",
          "uid": "abilities_app",
          "label": "外見 (APP)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "3d6*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "siz",
          "uid": "abilities_siz",
          "label": "体格 (SIZ)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "(2d6+6)*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "int",
          "uid": "abilities_int",
          "label": "知性 (INT)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "(2d6+6)*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        },
        {
          "type": "scalar",
          "id": "edu",
          "uid": "abilities_edu",
          "label": "教育 (EDU)",
          "valueType": "number",
          "rollOnCreate": {
            "notation": "(3d6+3)*5"
          },
          "role": {
            "kind": "rollable",
            "notation": "1d100<={value}",
            "group": "ability"
          }
        }
      ]
    },
    {
      "id": "status",
      "label": "ステータス",
      "fields": [
        {
          "type": "track",
          "id": "hp",
          "uid": "status_hp",
          "label": "耐久力",
          "style": "gauge",
          "max": {
            "formula": "floor(({abilities.con} + {abilities.siz}) / 10)"
          },
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              1
            ]
          }
        },
        {
          "type": "track",
          "id": "mp",
          "uid": "status_mp",
          "label": "マジックポイント",
          "style": "gauge",
          "max": {
            "formula": "floor({abilities.pow} / 5)"
          },
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              1
            ]
          }
        },
        {
          "type": "track",
          "id": "san",
          "uid": "status_san",
          "label": "正気度",
          "style": "gauge",
          "max": {
            "formula": "{abilities.pow}"
          },
          "role": {
            "kind": "resource",
            "deltas": [
              -1,
              -5,
              1,
              5
            ]
          }
        },
        {
          "type": "computed",
          "id": "idea",
          "uid": "status_idea",
          "label": "アイデア",
          "resultType": "number",
          "formula": "{abilities.int}"
        },
        {
          "type": "computed",
          "id": "luck",
          "uid": "status_luck",
          "label": "幸運",
          "resultType": "number",
          "formula": "{abilities.pow}"
        },
        {
          "type": "computed",
          "id": "knowledge",
          "uid": "status_knowledge",
          "label": "知識",
          "resultType": "number",
          "formula": "{abilities.edu}"
        },
        {
          "type": "computed",
          "id": "db",
          "uid": "status_db",
          "label": "ダメージボーナス",
          "resultType": "dice",
          "formula": "lookup({abilities.str} + {abilities.siz}, damage_bonus)"
        }
      ]
    },
    {
      "id": "skills",
      "label": "技能",
      "fields": [
