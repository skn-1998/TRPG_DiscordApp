          "label": "名前",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "job",
          "uid": "profile_job",
          "label": "職業",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "age",
          "uid": "profile_age",
          "label": "年齢",
          "valueType": "number"
        },
        {
          "type": "scalar",
          "id": "sex",
          "uid": "profile_sex",
          "label": "性別",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "birthplace",
          "uid": "profile_birthplace",
          "label": "出身",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "residence",
          "uid": "profile_residence",
          "label": "現住所",
          "valueType": "text"
        }
