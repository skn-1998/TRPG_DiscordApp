  "tables": [
    {
      "id": "damage_bonus",
      "resultType": "dice",
      "rows": [
        {
          "min": -999999,
          "max": 12,
          "result": "-1d6"
        },
        {
          "min": 13,
          "max": 16,
          "result": "-1d4"
        },
        {
          "min": 17,
          "max": 24,
          "result": "0"
        },
        {
          "min": 25,
          "max": 32,
          "result": "+1d4"
        },
        {
          "min": 33,
          "max": 40,
          "result": "+1d6"
        },
        {
          "min": 41,
          "max": 56,
          "result": "+2d6"
        },
        {
          "min": 57,
          "max": 72,
          "result": "+3d6"
        },
        {
          "min": 73,
          "max": 88,
          "result": "+4d6"
        },
        {
          "min": 89,
          "max": 104,
          "result": "+5d6"
        },
        {
          "min": 105,
