              "label": "武器名",
              "valueType": "text"
            },
            {
              "type": "scalar",
              "id": "value",
              "uid": "combat_list_value",
              "label": "技能値",
              "valueType": "number"
            },
            {
              "type": "scalar",
              "id": "damage",
              "uid": "combat_list_damage",
              "label": "ダメージ",
              "valueType": "text"
            }
          ],
          "rowRole": {
            "kind": "rollable",
            "notation": "1d100<={row.value}"
          }
        }
      ]
    },
    {
      "id": "gear",
      "label": "所持品",
      "fields": [
        {
          "type": "scalar",
          "id": "cash",
          "uid": "gear_cash",
          "label": "現金",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "assets",
          "uid": "gear_assets",
          "label": "資産",
          "valueType": "text"
        },
        {
          "type": "list",
          "id": "list",
          "uid": "gear_list",
          "label": "装備一覧",
          "itemFields": [
            {
              "type": "scalar",
              "id": "name",
              "uid": "gear_list_name",
              "label": "物品名",
              "valueType": "text"
            },
            {
              "type": "scalar",
              "id": "note",
              "uid": "gear_list_note",
              "label": "備考",
              "valueType": "text"
            }
          ]
        }
      ]
    },
    {
      "id": "memo",
      "label": "メモ",
      "fields": [
        {
          "type": "scalar",
          "id": "appearance",
          "uid": "memo_appearance",
          "label": "外見・描写",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "background",
          "uid": "memo_background",
          "label": "経歴",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "people",
          "uid": "memo_people",
          "label": "友人・知人",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "insanity",
          "uid": "memo_insanity",
          "label": "精神的障害",
          "valueType": "text"
        },
        {
          "type": "scalar",
          "id": "notes",
          "uid": "memo_notes",
          "label": "その他メモ",
          "valueType": "text"
        }
      ]
    }
  ],
