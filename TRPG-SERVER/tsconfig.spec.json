{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@domains/*": ["./src/domains/*"],
      "@auth/*": ["./src/auth/*"],
      "@discord/*": ["./src/discord/*"],
      "@events/*": ["./src/events/*"],
      "@shared/*": ["./src/shared/*"],
      "@utils/*": ["./src/utils/*"],
      "@middleware/*": ["./src/middleware/*"],
      "@discord-test-utils": ["./test/discord-test-utils/index.ts"],
      "@discord-test-utils/*": ["./test/discord-test-utils/*"],
      // src を baseUrl とした本体コードの import 解決（tsconfig.json と同等）
      "src/*": ["./src/*"],
      "events/*": ["./src/events/*"],
      "discord/*": ["./src/discord/*"],
      "shared/*": ["./src/shared/*"],
      "domains/*": ["./src/domains/*"],
      "auth/*": ["./src/auth/*"],
      "config/*": ["./src/config/*"],
      "utils/*": ["./src/utils/*"],
      "middleware/*": ["./src/middleware/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // テストファイルでのany使用を許容する設定
    "noImplicitAny": false,
    "strict": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "**/*.e2e-spec.ts"]
}
