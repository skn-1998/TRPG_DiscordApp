{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/test",
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "src/*": ["./src/*"],
      "@app/*": ["./src/*"],
      "@config/*": ["./src/config/*"],
      "@domains/*": ["./src/domains/*"],
      "@auth/*": ["./src/auth/*"],
      "@discord/*": ["./src/discord/*"],
      "@middleware/*": ["./src/middleware/*"]
    }
  },
  "include": ["src/**/*.spec.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/db/**/*", "src/DB/**/*"]
} 