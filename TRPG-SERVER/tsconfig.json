{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      // srcからの相対パス（推奨）
      "*": ["./*"],
      "src/*": ["./*"],

      // エイリアスパス（オプション）
      "@/*": ["./*"],
      "@app/*": ["./*"],
      "@config/*": ["./config/*"],
      "@domains/*": ["./domains/*"],
      "@auth/*": ["./auth/*"],
      "@discord/*": ["./discord/*"],
      "@events/*": ["./events/*"],
      "@shared/*": ["./shared/*"],
      "@utils/*": ["./utils/*"],
      "@middleware/*": ["./middleware/*"]
    },
    "incremental": true,
    "skipLibCheck": true,

    // 🔥 実用的な厳密型チェック設定
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": false, // DIコンテナ使用のため無効化

    // 🔍 実装可能なコード品質設定
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // 🚀 将来の強化予定（現在は互換性のため無効化）
    "exactOptionalPropertyTypes": false, // E-4（event contracts の any 解消）完了後に再評価（C-9 実測: src 49 件）
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,

    // その他の設定（既存）
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*", "src/config/**/*.ts", "src/types/**/*.d.ts", "test/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
