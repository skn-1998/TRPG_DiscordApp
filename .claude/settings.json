{
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000,
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/compact-log && { date '+%Y-%m-%d %H:%M:%S'; cat; printf '\\n--- git status ---\\n'; git status --short; } > \".claude/compact-log/precompact-$(date +%Y%m%d-%H%M%S).log\" 2>&1 || true"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p .claude/compact-log && cat > \".claude/compact-log/postcompact-$(date +%Y%m%d-%H%M%S).json\" 2>/dev/null; echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostCompact\",\"additionalContext\":\"compact 直後です。まず document/SESSION_HANDOFF.md を読み、fable-rules・AI.*.md・メモリ・.claude/compact-log/ で補完して状況を再同期してから作業を再開してください。\"}}'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run start:dev)",
      "Bash(pnpm run start:prod)",
      "Bash(pnpm run start:test)",
      "Bash(pnpm run start:dev:debug)",
      "Bash(pnpm run start:prod:debug)",
      "Bash(pnpm run start:test:debug)",
      "Bash(pnpm run start:dev:debug:watch)",
      "Bash(pnpm run build)",
      "Bash(pnpm run build:watch)",
      "Bash(pnpm run build:prod)",
      "Bash(pnpm run build:prod:watch)",
      "Bash(pnpm run build:test)",
      "Bash(pnpm run build:test:watch)",
      "Bash(pnpm run build:dev)",
      "Bash",
      "Edit",
      "Write",
      "Update",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:nestjs.com)",
      "WebFetch(domain:discord.com)",
      "WebFetch(domain:discord.js.org)",
      "WebFetch(domain:discord.js.org/docs/latest/api/index.html)",
      "WebFetch(domain:mongoosejs.com)",
      "WebFetch(domain:mongodb.com)",
      "WebFetch(domain:mongodb.com/docs/drivers/node/current/fundamentals/connection/)",
      "WebFetch(domain:remix.run)"
    ],
    "deny": [],
    "ask": []
  }
}