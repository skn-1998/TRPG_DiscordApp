{
  "name": "trpg-next-app",
  "private": true,
  "type": "module",
  "scripts": {
    "ensure:workspace-dist": "pnpm --filter \"trpg-next-app^...\" build",
    "build": "pnpm run ensure:workspace-dist && next build",
    "dev": "next dev -p 3100",
    "start": "next start",
    "typecheck": "pnpm run ensure:workspace-dist && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run ensure:workspace-dist && jest"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "@trpg/api-contract": "workspace:*",
    "@trpg/sheet-engine": "workspace:*",
    "axios": "1.18.1",
    "immer": "11.1.16",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.4.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
