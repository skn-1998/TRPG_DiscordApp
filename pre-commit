#!/bin/sh
#
# Pre-commit: ステージ済みファイルだけを prettier で整形し、そのファイルだけを再ステージする。
#
# 旧版は `pnpm run format`（ツリー全体を --write）の後に `git add .` を実行しており、
# コミットのたびに無関係な作業ツリー変更（他機能の WIP・worktree 等）まで巻き込んでいた。
# スコープを絞ったコミットができるよう、対象をステージ済みファイルに限定する。

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# パッケージ単位で、そのパッケージにステージされた対象拡張子のファイルだけを整形・再ステージする。
# prettier は各パッケージの prettier.config.js を解決するため、パッケージ内で実行する。
format_pkg() {
  pkg="$1"
  files=$(echo "$staged" | grep -E "^${pkg}/" | grep -Ei '\.(ts|tsx|js|jsx|json|md|html)$' | sed "s#^${pkg}/##")
  [ -z "$files" ] && return 0
  ( cd "$pkg" && echo "$files" | tr '\n' '\0' | xargs -0 -r npx prettier --write --log-level warn ) || {
    echo "pre-commit: prettier の整形に失敗しました（$pkg）。整形をスキップしてコミットを続行します。" >&2
    return 0
  }
  echo "$files" | sed "s#^#${pkg}/#" | tr '\n' '\0' | xargs -0 -r git add
}

format_pkg "TRPG-SERVER"
format_pkg "trpg-remix-app"

exit 0
